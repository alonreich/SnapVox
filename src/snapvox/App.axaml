<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="snapvox.App"
             RequestedThemeVariant="Dark">
    <!-- Shared design system: single source of truth for colors/fonts/sizes (ISSUE_001) -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://snapvox.editor/Themes/DesignSystem.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar[Orientation=Vertical]">
            <Setter Property="Theme" Value="{DynamicResource SnapVoxScrollBarVertical}" />
        </Style>
        <Style Selector="ScrollBar[Orientation=Horizontal]">
            <Setter Property="Theme" Value="{DynamicResource SnapVoxScrollBarHorizontal}" />
        </Style>
        <Style Selector="FlyoutPresenter ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="FlyoutPresenter ScrollBar[Orientation=Vertical]">
            <Setter Property="Theme" Value="{DynamicResource SnapVoxScrollBarVertical}" />
        </Style>
        <Style Selector="FlyoutPresenter ScrollBar[Orientation=Horizontal]">
            <Setter Property="Theme" Value="{DynamicResource SnapVoxScrollBarHorizontal}" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="SnapVox v3.0" Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Capture Region (PrintScreen)" Click="OnCaptureRegionClick" Icon="avares://SnapVox/icons/ruler-crop.png" />
                        <NativeMenuItem Header="Repeat Last Region" Click="OnCaptureLastRegionClick" Icon="avares://SnapVox/icons/repeat.png" />
                        <NativeMenuItem Header="Capture Window (Alt+PrintScreen)" Click="OnCaptureWindowClick" Icon="avares://SnapVox/icons/shape_square_add.png" />
                        <NativeMenuItem Header="Capture Fullscreen (Ctrl+PrintScreen)" Click="OnCaptureFullscreenClick" Icon="avares://SnapVox/icons/fullscreen.png" />
                        <NativeMenuItem Header="Scroll Capture (Space)" Click="OnScrollCaptureClick" Icon="avares://SnapVox/icons/scroll-capture.png" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Open From Clipboard" Click="OnOpenFromClipboardClick" Icon="avares://SnapVox/icons/clipboard.png" />
                        <NativeMenuItem Header="Show Capture History" Click="OnShowHistoryClick" Icon="avares://SnapVox/icons/folder_explore.png" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Settings" Click="OnSettingsClick" Icon="avares://SnapVox/icons/wrench.png" />
                        <NativeMenuItem Header="View Logs" Click="OnViewLogsClick" Icon="avares://SnapVox/icons/log.png" />
                        <NativeMenuItem Header="Exit" Click="OnExitClick" Icon="avares://SnapVox/icons/cross.png" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>