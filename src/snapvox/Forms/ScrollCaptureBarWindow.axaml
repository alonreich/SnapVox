<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="snapvox.forms.ScrollCaptureBarWindow"
        Title="Scroll Capture Controller"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        CanResize="False"
        ShowInTaskbar="False"
        Width="460"
        Height="64"
        WindowStartupLocation="Manual"
        Cursor="Arrow">
    <Border Background="#F2181A1F"
            BorderBrush="{DynamicResource SnapVoxScrollAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="30"
            Padding="14,6"
            Margin="6"
            BoxShadow="0 6 24 0 #99000000"
            PointerPressed="OnPillPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
            <!-- Pulsing REC Indicator -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,14,0">
                <Ellipse Classes="pulse" Width="12" Height="12" Fill="{DynamicResource SnapVoxDestructiveHoverBrush}" VerticalAlignment="Center">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse.pulse">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                    <KeyFrame KeyTime="0:0:0.5"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                                    <KeyFrame KeyTime="0:0:1"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
                <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SnapVoxDestructiveHoverBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Screen Counter & Instructions -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Name="ScreensBadge" Text="Captured: 1.0 screens (1 frame)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" />
                <TextBlock Name="SubtextHint" Text="Scroll down · Space or click Finish" FontSize="10.5" Foreground="{DynamicResource SnapVoxSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Green On-Screen Finish Button -->
            <Button Grid.Column="2" Name="FinishButton" Content="✓ Finish Capture" Click="OnFinishClick"
                    AutomationProperties.Name="Finish scroll capture"
                    Background="{DynamicResource SnapVoxSuccessBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"
                    FontWeight="Bold" FontSize="12"
                    CornerRadius="16" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button#FinishButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SnapVoxSuccessHoverBrush}" />
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Cancel Button -->
            <Button Grid.Column="3" Name="CancelButton" Content="✕" Click="OnCancelClick"
                    AutomationProperties.Name="Cancel scroll capture" ToolTip.Tip="Cancel (Esc)"
                    Background="{DynamicResource SnapVoxSecondaryButtonBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"
                    FontWeight="Bold" FontSize="12"
                    CornerRadius="14" Width="28" Height="28" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button#CancelButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SnapVoxDestructiveBrush}" />
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Border>
</Window>
