<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="snapvox.forms.DeploymentProgressWindow"
        Title="SnapVox Setup"
        AutomationProperties.Name="SnapVox setup progress"
        Width="720" Height="480"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{DynamicResource SnapVoxCanvasBrush}"
        Topmost="False"
        ShowInTaskbar="True"
        CanResize="True">
    <!-- ISSUE_012: theme is set once at the Application level (App.axaml). -->
    <Border Background="{DynamicResource SnapVoxPanelDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource SnapVoxAccentBrush}" BorderThickness="2" Margin="8">
        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock Name="TitleText"
                       Grid.Row="0"
                       Text="Installing SnapVox"
                       Foreground="{DynamicResource SnapVoxAccentBrush}"
                       FontSize="{DynamicResource SnapVoxDeploymentTitleFontSize}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Name="LogPathText"
                       Grid.Row="1"
                       Text=""
                       Foreground="{DynamicResource SnapVoxDimTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <!-- ISSUE_015: dedicated error banner shown when deployment fails. -->
            <Border Name="ErrorBanner"
                    Grid.Row="2"
                    Background="{DynamicResource SnapVoxDestructiveSurfaceBrush}"
                    BorderBrush="{DynamicResource SnapVoxDestructiveBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,8"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#9888;" Foreground="{DynamicResource SnapVoxWarningBrush}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Name="ErrorText" Text="Deployment failed." Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Name="PhaseText"
                           Text="Initializing..."
                           Foreground="{DynamicResource SnapVoxSecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="PercentageText"
                           Grid.Column="1"
                           Text="0%"
                           Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
            <ListBox Name="LogList"
                     Grid.Row="4"
                     AutomationProperties.Name="Installation log"
                     Background="{DynamicResource SnapVoxCanvasBrush}"
                     BorderThickness="0"
                     Foreground="{DynamicResource SnapVoxLogTextBrush}"
                     FontFamily="Consolas,Courier New,monospace"
                     FontSize="12"
                     Padding="8"/>
            <ProgressBar Name="ProgressBar"
                         Grid.Row="5"
                         AutomationProperties.Name="Installation progress"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource SnapVoxAccentBrush}"
                         Background="{DynamicResource SnapVoxActionButtonBrush}"
                         Margin="0,12,0,12"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <!-- ISSUE_015: cancel button lets users abort a stalled install. -->
                <Button Name="CancelButton"
                        Content="Cancel"
                        AutomationProperties.Name="Cancel installation"
                        MinWidth="120"
                        Height="32"
                        Cursor="Hand"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource SnapVoxSecondaryButtonBrush}"
                        Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"
                        Click="OnCancelClick"/>
            </StackPanel>
            <Button Name="FinishButton"
                    Grid.Row="7"
                    Content="Finish"
                    AutomationProperties.Name="Finish and close setup"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    MinWidth="120"
                    Height="32"
                    Cursor="Hand"
                    IsVisible="False"
                    Background="{DynamicResource SnapVoxAccentBrush}"
                    Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="OnFinishClick"/>
        </Grid>
    </Border>
</Window>