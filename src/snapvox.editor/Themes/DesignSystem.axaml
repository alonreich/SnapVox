<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═════════════════════════════════════════════════════════════════
         SnapVox Shared Design System
         Single source of truth for colors, brushes, and sizing tokens.
         Merge this dictionary at the Application level (App.axaml) so every
         window inherits the same values automatically.
         ═════════════════════════════════════════════════════════════════ -->

    <!-- ── Accent (brand) ── -->
    <Color x:Key="SnapVoxAccentColor">#007ACC</Color>
    <SolidColorBrush x:Key="SnapVoxAccentBrush" Color="{StaticResource SnapVoxAccentColor}" />

    <Color x:Key="SnapVoxAccentDarkColor">#005A9E</Color>
    <SolidColorBrush x:Key="SnapVoxAccentDarkBrush" Color="{StaticResource SnapVoxAccentDarkColor}" />

    <!-- ── Backgrounds ── -->
    <Color x:Key="SnapVoxCanvasColor">#1E1E1E</Color>
    <SolidColorBrush x:Key="SnapVoxCanvasBrush" Color="{StaticResource SnapVoxCanvasColor}" />

    <Color x:Key="SnapVoxPanelDarkColor">#2D2D30</Color>
    <SolidColorBrush x:Key="SnapVoxPanelDarkBrush" Color="{StaticResource SnapVoxPanelDarkColor}" />

    <Color x:Key="SnapVoxToolbarColor">#808080</Color>
    <SolidColorBrush x:Key="SnapVoxToolbarBrush" Color="{StaticResource SnapVoxToolbarColor}" />

    <Color x:Key="SnapVoxActionButtonColor">#3E3E42</Color>
    <SolidColorBrush x:Key="SnapVoxActionButtonBrush" Color="{StaticResource SnapVoxActionButtonColor}" />

    <Color x:Key="SnapVoxSecondaryButtonColor">#444444</Color>
    <SolidColorBrush x:Key="SnapVoxSecondaryButtonBrush" Color="{StaticResource SnapVoxSecondaryButtonColor}" />

    <!-- ── Borders & separators ── -->
    <Color x:Key="SnapVoxSeparatorColor">#555555</Color>
    <SolidColorBrush x:Key="SnapVoxSeparatorBrush" Color="{StaticResource SnapVoxSeparatorColor}" />

    <!-- ── Text ── -->
    <Color x:Key="SnapVoxPrimaryTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SnapVoxPrimaryTextBrush" Color="{StaticResource SnapVoxPrimaryTextColor}" />

    <Color x:Key="SnapVoxSecondaryTextColor">#AAAAAA</Color>
    <SolidColorBrush x:Key="SnapVoxSecondaryTextBrush" Color="{StaticResource SnapVoxSecondaryTextColor}" />

    <!-- High-contrast text for use on #808080 toolbars (ISSUE_005) -->
    <Color x:Key="SnapVoxToolbarTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SnapVoxToolbarTextBrush" Color="{StaticResource SnapVoxToolbarTextColor}" />

    <Color x:Key="SnapVoxDimTextColor">#888888</Color>
    <SolidColorBrush x:Key="SnapVoxDimTextBrush" Color="{StaticResource SnapVoxDimTextColor}" />

    <Color x:Key="SnapVoxLogTextColor">#C0CAF5</Color>
    <SolidColorBrush x:Key="SnapVoxLogTextBrush" Color="{StaticResource SnapVoxLogTextColor}" />

    <!-- ── Interactive states ── -->
    <Color x:Key="SnapVoxHoverColor">#757575</Color>
    <Color x:Key="SnapVoxPressedColor">#5A5A5A</Color>

    <!-- ── Status colors ── -->
    <Color x:Key="SnapVoxDestructiveColor">#A51D2D</Color>
    <SolidColorBrush x:Key="SnapVoxDestructiveBrush" Color="{StaticResource SnapVoxDestructiveColor}" />

    <Color x:Key="SnapVoxDestructiveHoverColor">#C42B3D</Color>

    <Color x:Key="SnapVoxSuccessColor">#107C10</Color>
    <SolidColorBrush x:Key="SnapVoxSuccessBrush" Color="{StaticResource SnapVoxSuccessColor}" />

    <!-- ── Snip frame (ISSUE_009: mandated #000080 navy) ── -->
    <Color x:Key="SnapVoxFrameBorderColor">#000080</Color>
    <SolidColorBrush x:Key="SnapVoxFrameBorderBrush" Color="{StaticResource SnapVoxFrameBorderColor}" />

    <!-- ── Checkerboard tile colors ── -->
    <Color x:Key="SnapVoxCheckerDarkColor">#333333</Color>
    <Color x:Key="SnapVoxCheckerLightColor">#3A3A3A</Color>

    <!-- ── Capture overlay accent ── -->
    <Color x:Key="SnapVoxScrollAccentColor">#00AEEF</Color>
    <SolidColorBrush x:Key="SnapVoxScrollAccentBrush" Color="{StaticResource SnapVoxScrollAccentColor}" />

    <!-- ── Font sizes ── -->
    <x:Double x:Key="SnapVoxToolbarFontSize">11</x:Double>
    <x:Double x:Key="SnapVoxTitleFontSize">12</x:Double>
    <x:Double x:Key="SnapVoxHeaderFontSize">14</x:Double>
    <x:Double x:Key="SnapVoxDialogTitleFontSize">18</x:Double>
    <x:Double x:Key="SnapVoxDeploymentTitleFontSize">20</x:Double>
</ResourceDictionary>