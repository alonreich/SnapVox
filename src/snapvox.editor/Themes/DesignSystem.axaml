<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═════════════════════════════════════════════════════════════════
         SnapVox Shared Design System
         Single source of truth for colors, brushes, and sizing tokens.
         Merge this dictionary at the Application level (App.axaml) so every
         window inherits the same values automatically.
         ═════════════════════════════════════════════════════════════════ -->

    <!-- ── Accent (brand) ── -->
    <Color x:Key="SnapVoxAccentColor">#007ACC</Color>
    <SolidColorBrush x:Key="SnapVoxAccentBrush" Color="{StaticResource SnapVoxAccentColor}" />

    <Color x:Key="SnapVoxAccentDarkColor">#005A9E</Color>
    <SolidColorBrush x:Key="SnapVoxAccentDarkBrush" Color="{StaticResource SnapVoxAccentDarkColor}" />

    <!-- ── Backgrounds ── -->
    <Color x:Key="SnapVoxCanvasColor">#1E1E1E</Color>
    <SolidColorBrush x:Key="SnapVoxCanvasBrush" Color="{StaticResource SnapVoxCanvasColor}" />

    <Color x:Key="SnapVoxPanelDarkColor">#2D2D30</Color>
    <SolidColorBrush x:Key="SnapVoxPanelDarkBrush" Color="{StaticResource SnapVoxPanelDarkColor}" />

    <Color x:Key="SnapVoxToolbarColor">#808080</Color>
    <SolidColorBrush x:Key="SnapVoxToolbarBrush" Color="{StaticResource SnapVoxToolbarColor}" />

    <Color x:Key="SnapVoxActionButtonColor">#3E3E42</Color>
    <SolidColorBrush x:Key="SnapVoxActionButtonBrush" Color="{StaticResource SnapVoxActionButtonColor}" />

    <Color x:Key="SnapVoxSecondaryButtonColor">#444444</Color>
    <SolidColorBrush x:Key="SnapVoxSecondaryButtonBrush" Color="{StaticResource SnapVoxSecondaryButtonColor}" />

    <!-- ── Borders & separators ── -->
    <Color x:Key="SnapVoxSelectedSurfaceColor">#402D2D30</Color>
    <SolidColorBrush x:Key="SnapVoxSelectedSurfaceBrush" Color="{StaticResource SnapVoxSelectedSurfaceColor}" />

    <Color x:Key="SnapVoxSliderTrackColor">#4A4A4A</Color>
    <SolidColorBrush x:Key="SnapVoxSliderTrackBrush" Color="{StaticResource SnapVoxSliderTrackColor}" />

    <Color x:Key="SnapVoxScrimColor">#99000000</Color>
    <SolidColorBrush x:Key="SnapVoxScrimBrush" Color="{StaticResource SnapVoxScrimColor}" />

    <Color x:Key="SnapVoxSeparatorColor">#555555</Color>
    <SolidColorBrush x:Key="SnapVoxSeparatorBrush" Color="{StaticResource SnapVoxSeparatorColor}" />

    <!-- ── Text ── -->
    <Color x:Key="SnapVoxPrimaryTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SnapVoxPrimaryTextBrush" Color="{StaticResource SnapVoxPrimaryTextColor}" />

    <Color x:Key="SnapVoxSecondaryTextColor">#AAAAAA</Color>
    <SolidColorBrush x:Key="SnapVoxSecondaryTextBrush" Color="{StaticResource SnapVoxSecondaryTextColor}" />

    <!-- High-contrast text for use on #808080 toolbars (ISSUE_005) -->
    <Color x:Key="SnapVoxToolbarTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SnapVoxToolbarTextBrush" Color="{StaticResource SnapVoxToolbarTextColor}" />

    <Color x:Key="SnapVoxDimTextColor">#888888</Color>
    <SolidColorBrush x:Key="SnapVoxDimTextBrush" Color="{StaticResource SnapVoxDimTextColor}" />

    <Color x:Key="SnapVoxLogTextColor">#C0CAF5</Color>
    <SolidColorBrush x:Key="SnapVoxLogTextBrush" Color="{StaticResource SnapVoxLogTextColor}" />

    <!-- ── Interactive states ── -->
    <Color x:Key="SnapVoxHoverColor">#757575</Color>
    <SolidColorBrush x:Key="SnapVoxHoverBrush" Color="{StaticResource SnapVoxHoverColor}" />

    <Color x:Key="SnapVoxPressedColor">#5A5A5A</Color>
    <SolidColorBrush x:Key="SnapVoxPressedBrush" Color="{StaticResource SnapVoxPressedColor}" />

    <!-- ── Status colors ── -->
    <Color x:Key="SnapVoxDestructiveColor">#A51D2D</Color>
    <SolidColorBrush x:Key="SnapVoxDestructiveBrush" Color="{StaticResource SnapVoxDestructiveColor}" />

    <Color x:Key="SnapVoxDestructiveHoverColor">#C42B3D</Color>
    <SolidColorBrush x:Key="SnapVoxDestructiveHoverBrush" Color="{StaticResource SnapVoxDestructiveHoverColor}" />

    <Color x:Key="SnapVoxDestructiveSurfaceColor">#3A1218</Color>
    <SolidColorBrush x:Key="SnapVoxDestructiveSurfaceBrush" Color="{StaticResource SnapVoxDestructiveSurfaceColor}" />

    <Color x:Key="SnapVoxWarningColor">#FFB400</Color>
    <SolidColorBrush x:Key="SnapVoxWarningBrush" Color="{StaticResource SnapVoxWarningColor}" />

    <Color x:Key="SnapVoxSuccessColor">#107C10</Color>
    <SolidColorBrush x:Key="SnapVoxSuccessBrush" Color="{StaticResource SnapVoxSuccessColor}" />

    <Color x:Key="SnapVoxSuccessHoverColor">#1F8B24</Color>
    <SolidColorBrush x:Key="SnapVoxSuccessHoverBrush" Color="{StaticResource SnapVoxSuccessHoverColor}" />

    <!-- ── Snip frame (ISSUE_009: mandated #000080 navy) ── -->
    <Color x:Key="SnapVoxFrameBorderColor">#000080</Color>
    <SolidColorBrush x:Key="SnapVoxFrameBorderBrush" Color="{StaticResource SnapVoxFrameBorderColor}" />

    <!-- ── Checkerboard tile colors ── -->
    <Color x:Key="SnapVoxCheckerDarkColor">#333333</Color>
    <SolidColorBrush x:Key="SnapVoxCheckerDarkBrush" Color="{StaticResource SnapVoxCheckerDarkColor}" />

    <Color x:Key="SnapVoxCheckerLightColor">#3A3A3A</Color>
    <SolidColorBrush x:Key="SnapVoxCheckerLightBrush" Color="{StaticResource SnapVoxCheckerLightColor}" />

    <!-- ── Capture overlay accent ── -->
    <Color x:Key="SnapVoxScrollAccentColor">#00AEEF</Color>
    <SolidColorBrush x:Key="SnapVoxScrollAccentBrush" Color="{StaticResource SnapVoxScrollAccentColor}" />

    <!-- ── Drawing Palette & Structural Colors ── -->
    <Color x:Key="SnapVoxPaletteBlackColor">#000000</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteBlackBrush" Color="{StaticResource SnapVoxPaletteBlackColor}" />
    <Color x:Key="SnapVoxPaletteGreenColor">#00FF00</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteGreenBrush" Color="{StaticResource SnapVoxPaletteGreenColor}" />
    <Color x:Key="SnapVoxPaletteRedColor">#FF0000</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteRedBrush" Color="{StaticResource SnapVoxPaletteRedColor}" />
    <Color x:Key="SnapVoxPaletteYellowColor">#FFFF00</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteYellowBrush" Color="{StaticResource SnapVoxPaletteYellowColor}" />
    <Color x:Key="SnapVoxPaletteBlueColor">#0000FF</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteBlueBrush" Color="{StaticResource SnapVoxPaletteBlueColor}" />
    <Color x:Key="SnapVoxPaletteWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SnapVoxPaletteWhiteBrush" Color="{StaticResource SnapVoxPaletteWhiteColor}" />

    <Color x:Key="SnapVoxHitTestScrimColor">#01000000</Color>
    <SolidColorBrush x:Key="SnapVoxHitTestScrimBrush" Color="{StaticResource SnapVoxHitTestScrimColor}" />
    
    <Color x:Key="SnapVoxMagnifierBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="SnapVoxMagnifierBackgroundBrush" Color="{StaticResource SnapVoxMagnifierBackgroundColor}" />

    <!-- ── Scrollbar themes (ISSUE: broken scrollbar visuals) ──
         The Fluent scrollbar template renders a translucent overlay thumb and no visible
         arrows, which is unreadable on SnapVox's #1E1E1E canvas and reads as "scrolling is
         broken". These themes draw a solid rounded thumb, a subtle sunken track and explicit
         chevron arrows with hover/press feedback. Applied per-scrollviewer via
         ScrollBar[Orientation=...] Theme styles (see ImageEditorWindow.axaml). -->
    <ControlTheme x:Key="SnapVoxScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#78C8C8C8" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="ThumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#B4DCDCDC" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>
    </ControlTheme>

    <!-- Minimal arrow button: transparent chrome, hover/press tinted pill, centered glyph.
         Own theme (instead of the Fluent default) so Fluent's hover brushes cannot fight it. -->
    <ControlTheme x:Key="SnapVoxScrollBarArrow" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="ArrowBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#ArrowBorder">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ArrowBorder">
            <Setter Property="Background" Value="#55FFFFFF" />
        </Style>
    </ControlTheme>

    <!-- Invisible page-up/page-down click target filling the track gutters. -->
    <ControlTheme x:Key="SnapVoxScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>

    <!-- ScrollBar wires its scrolling behaviour to the PART_* named buttons/track below;
         it exposes no command properties in Avalonia 11. -->
    <!-- ISSUE_031 (scrollbar width & arrow proportions): the bars were 14px while the arrow
         cells were 16px, and the chevrons were tiny 6px glyphs with a hairline stroke - the
         arrows looked squashed and out of proportion with the bar itself. Bars are now 18px
         with 18x18 square arrow cells and chevrons drawn to the bar's own scale (8px span,
         2px stroke) so bar and arrows stay proportional. -->
    <ControlTheme x:Key="SnapVoxScrollBarVertical" TargetType="ScrollBar">
        <Setter Property="Width" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Background" Value="#262D2D30" />
        <Setter Property="Foreground" Value="#D6D6D6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}" MinWidth="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>
                        <RepeatButton Grid.Row="0" Name="PART_LineUpButton" Theme="{StaticResource SnapVoxScrollBarArrow}" Interval="60" Delay="250" CornerRadius="3,3,0,0" Cursor="Hand">
                            <Path Data="M 5 11 L 9 7 L 13 11" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </RepeatButton>
                        <Track Grid.Row="1" Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource SnapVoxScrollBarPage}" Interval="60" Delay="250" />
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Theme="{StaticResource SnapVoxScrollBarThumb}" MinHeight="24" Margin="1,0" />
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource SnapVoxScrollBarPage}" Interval="60" Delay="250" />
                            </Track.IncreaseButton>
                        </Track>
                        <RepeatButton Grid.Row="2" Name="PART_LineDownButton" Theme="{StaticResource SnapVoxScrollBarArrow}" Interval="60" Delay="250" CornerRadius="0,0,3,3" Cursor="Hand">
                            <Path Data="M 5 7 L 9 11 L 13 7" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>

    <!-- ── Font sizes ── -->
    <x:Double x:Key="SnapVoxMinTouchTarget">24</x:Double>
    <x:Double x:Key="SnapVoxToolbarFontSize">11</x:Double>
    <x:Double x:Key="SnapVoxTitleFontSize">12</x:Double>
    <x:Double x:Key="SnapVoxHeaderFontSize">14</x:Double>
    <x:Double x:Key="SnapVoxDialogTitleFontSize">18</x:Double>
    <x:Double x:Key="SnapVoxDeploymentTitleFontSize">20</x:Double>

    <ControlTheme x:Key="SnapVoxScrollBarHorizontal" TargetType="ScrollBar">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="#262D2D30" />
        <Setter Property="Foreground" Value="#D6D6D6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}" MinHeight="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <RepeatButton Grid.Column="0" Name="PART_LineLeftButton" Theme="{StaticResource SnapVoxScrollBarArrow}" Interval="60" Delay="250" CornerRadius="3,0,0,3" Cursor="Hand">
                            <Path Data="M 11 5 L 7 9 L 11 13" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </RepeatButton>
                        <Track Grid.Column="1" Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageLeftButton" Theme="{StaticResource SnapVoxScrollBarPage}" Interval="60" Delay="250" />
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Theme="{StaticResource SnapVoxScrollBarThumb}" MinWidth="24" Margin="0,1" />
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageRightButton" Theme="{StaticResource SnapVoxScrollBarPage}" Interval="60" Delay="250" />
                            </Track.IncreaseButton>
                        </Track>
                        <RepeatButton Grid.Column="2" Name="PART_LineRightButton" Theme="{StaticResource SnapVoxScrollBarArrow}" Interval="60" Delay="250" CornerRadius="0,3,3,0" Cursor="Hand">
                            <Path Data="M 7 5 L 11 9 L 7 13" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
</ResourceDictionary>