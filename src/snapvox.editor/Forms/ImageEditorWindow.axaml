<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        x:Class="snapvox.editor.forms.ImageEditorWindow"
        Title="SnapVox Editor"
        Background="{DynamicResource SnapVoxCanvasBrush}"
        ShowInTaskbar="True"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        MinWidth="880" MinHeight="630"
        WindowStartupLocation="Manual"
        Cursor="Arrow">
    <Window.Resources>
        <VisualBrush x:Key="CheckerboardBrush" TileMode="Tile" SourceRect="0,0,20,20" DestinationRect="0,0,20,20">
            <VisualBrush.Visual>
                <Canvas Width="20" Height="20">
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource SnapVoxCheckerDarkBrush}" />
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource SnapVoxCheckerDarkBrush}" Canvas.Left="10" Canvas.Top="10" />
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource SnapVoxCheckerLightBrush}" Canvas.Left="10" />
                    <Rectangle Width="10" Height="10" Fill="{DynamicResource SnapVoxCheckerLightBrush}" Canvas.Top="10" />
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>
    </Window.Resources>

    
    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            
            <Setter Property="Foreground" Value="{DynamicResource SnapVoxPrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource SnapVoxActionButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SnapVoxPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ActionBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="Black" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            BoxShadow="0 2 5 0 #88000000">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.05" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.action:pressed /template/ Border#ActionBorder">
            <Setter Property="RenderTransform" Value="scale(0.96) translateY(1px)" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #AA000000" />
        </Style>
        <Style Selector="Button.action:hover /template/ Border#ActionBorder">
            <Setter Property="Background" Value="{DynamicResource SnapVoxHoverBrush}" />
        </Style>
        <Style Selector="Button.context-delete">
            <Setter Property="Background" Value="{DynamicResource SnapVoxDestructiveBrush}" />
        </Style>
        <Style Selector="Button.context-delete:hover /template/ Border#ActionBorder">
            <Setter Property="Background" Value="{DynamicResource SnapVoxDestructiveHoverBrush}" />
        </Style>
        <Style Selector="Button.context-apply">
            <Setter Property="Background" Value="{DynamicResource SnapVoxSuccessBrush}" />
        </Style>
        <Style Selector="Button.context-apply:hover /template/ Border#ActionBorder">
            <Setter Property="Background" Value="{DynamicResource SnapVoxSuccessHoverBrush}" />
        </Style>
        <Style Selector="Button.toolbar:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxToolbarBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1,1,2,2" />
            <Setter Property="BorderBrush" Value="#44000000" />
            <Setter Property="Transitions">
                <Transitions>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.toolbar:hover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxHoverBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxPressedBrush}" />
            <Setter Property="BorderThickness" Value="2,2,1,1" />
            <Setter Property="BorderBrush" Value="#88000000" />
        </Style>
        <Style Selector="Button.toolbar.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#660078D7" />
            <Setter Property="BorderThickness" Value="2,2,1,1" />
            <Setter Property="BorderBrush" Value="#88000000" />
        </Style>
        
        

        <Style Selector="Button.destructive:hover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxDestructiveBrush}" />
            <Setter Property="BorderThickness" Value="2,2,1,1" />
            <Setter Property="BorderBrush" Value="#88000000" />
        </Style>
        <Style Selector="Button.destructive:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxDestructiveHoverBrush}" />
            <Setter Property="BorderThickness" Value="2,2,1,1" />
            <Setter Property="BorderBrush" Value="#88000000" />
        </Style>
        
        <Style Selector="ScrollViewer#EditorScrollViewer ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollViewer#EditorScrollViewer ScrollBar[Orientation=Vertical]">
            <Setter Property="Theme" Value="{StaticResource SnapVoxScrollBarVertical}" />
        </Style>
        <Style Selector="ScrollViewer#EditorScrollViewer ScrollBar[Orientation=Horizontal]">
            <Setter Property="Theme" Value="{StaticResource SnapVoxScrollBarHorizontal}" />
        </Style>
        <Style Selector="Button.color-preset">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SnapVoxSecondaryButtonBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.color-preset.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SnapVoxPrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Rectangle.selection-indicator">
            <Setter Property="Stroke" Value="Yellow"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="4,2"/>
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1.5">
                        <Setter Property="StrokeDashOffset" Value="6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.thickness">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.thickness:hover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxHoverBrush}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.thickness.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SnapVoxSelectedSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.thickness.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SnapVoxPrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Slider.pixelate-strength">
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SnapVoxAccentDarkBrush}" />
            <Setter Property="Background" Value="{DynamicResource SnapVoxSliderTrackBrush}" />
        </Style>
        <Style Selector="Slider.pixelate-strength /template/ Thumb">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <Style Selector="Button.zoom-text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SnapVoxToolbarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.zoom-text:hover">
            <Setter Property="Background" Value="{DynamicResource SnapVoxHoverBrush}" />
        </Style>
        <Style Selector="Button.zoom-text:pressed">
            <Setter Property="Background" Value="{DynamicResource SnapVoxPressedBrush}" />
        </Style>
        
        <Style Selector="Button.emoji-btn">
            <Setter Property="FontFamily" Value="avares://snapvox.editor/Drawing/Emoji/#Twemoji Mozilla"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.emoji-btn:hover">
            <Setter Property="Background" Value="{DynamicResource SnapVoxHoverBrush}" />
        </Style>
        <Style Selector="Button.emoji-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource SnapVoxPressedBrush}" />
        </Style>
        
        <Style Selector="Border.counter">
            <Setter Property="Background" Value="Red" />
            <Setter Property="CornerRadius" Value="17.5" />
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
        </Style>
        <Style Selector="Border.counter TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SnapVoxPrimaryTextBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        
        <Style Selector="Control.ink-stamp">
            <Style.Animations>
                <Animation Duration="0:0:0.28" FillMode="Forward">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="RenderTransform" Value="scale(0.6)"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.18">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="RenderTransform" Value="scale(1.12)"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.28">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Control.ink-dissolve">
            <Style.Animations>
                <Animation Duration="0:0:0.2" FillMode="Forward">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:0.2">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="RenderTransform" Value="scale(0.8)"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel>
    <DockPanel Name="EditorContentRoot">
        <Grid DockPanel.Dock="Top" Name="TitleBar" Height="32" ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource SnapVoxPanelDarkBrush}" Cursor="Arrow" PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Image Source="avares://SnapVox/SnapVox.ico" Width="16" Height="16" Margin="0,0,8,0" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="SnapVox Editor" Foreground="{DynamicResource SnapVoxSecondaryTextBrush}" FontSize="{DynamicResource SnapVoxTitleFontSize}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="TitleDimensionText" Grid.Column="1" Text="0 x 0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" FontSize="{DynamicResource SnapVoxTitleFontSize}" FontWeight="SemiBold"/>
            <Border Grid.Column="2" Width="140" Background="Transparent" IsHitTestVisible="False"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SnapVoxToolbarBrush}" Height="60" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="0,0,0,1" Cursor="Arrow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Name="TopToolbarStackPanel" Grid.Column="0" Orientation="Horizontal" Margin="10,0" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="toolbar" Name="DownloadButton" AutomationProperties.Name="Save image to Downloads" ToolTip.Tip="Save image to Downloads (Ctrl+S)" Click="OnDownloadClick" IsDefault="False">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/download.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="CopyButton" AutomationProperties.Name="Copy image to clipboard" ToolTip.Tip="Copy image to clipboard (Ctrl+C)" Click="OnCopyClick" IsDefault="False">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/copy.svg" />
                    </Button>
                    
                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />
                    
                    <Button Classes="toolbar" Name="UndoButton" AutomationProperties.Name="Undo" ToolTip.Tip="Undo (Ctrl+Z)" Click="OnUndoClick" IsEnabled="False">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/undo.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="RedoButton" AutomationProperties.Name="Redo" ToolTip.Tip="Redo (Ctrl+Y)" Click="OnRedoClick" IsEnabled="False">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/redo.svg" />
                    </Button>
                    
                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />

                    <Button Classes="toolbar" Name="RotateCwButton" AutomationProperties.Name="Rotate clockwise" ToolTip.Tip="Rotate Clockwise" Click="OnRotateCwClick">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/rotate_clock-wise.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="RotateCcwButton" AutomationProperties.Name="Rotate counter-clockwise" ToolTip.Tip="Rotate Counter-Clockwise" Click="OnRotateCcwClick">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/rotate_counter_clock-wise.svg" />
                    </Button>

                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />
                    <Button Classes="toolbar" Name="DeleteButton" AutomationProperties.Name="Delete selected object" ToolTip.Tip="Delete Selected Object (Del)" Click="OnDeleteClick" IsEnabled="False">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/delete.svg" />
                    </Button>

                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />
                    <Button Classes="toolbar" Name="CropTool" AutomationProperties.Name="Crop tool" ToolTip.Tip="Crop region. Esc exits this tool." Click="OnToolClick" Tag="Crop">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/crop.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="ResizeButton" AutomationProperties.Name="Resize image" ToolTip.Tip="Resize image (changes the picture's real pixel size)" Click="OnResizeClick">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/resize.svg" />
                    </Button>

                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />
                    <Button Classes="toolbar" Name="OcrButton" AutomationProperties.Name="OCR text extraction" ToolTip.Tip="Copy text, save text file, and open Notepad" Click="OnOcrClick" Width="NaN" MinWidth="40" Padding="5,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/ocr.svg" />
                            <TextBlock Name="OcrButtonText" Text="OCR Text Extraction" VerticalAlignment="Center" FontSize="{DynamicResource SnapVoxToolbarFontSize}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Classes="toolbar destructive" Name="ClearAllButton" AutomationProperties.Name="Clear all objects" ToolTip.Tip="Removes every object you added to this image. Asks first." Click="OnClearAllClick" Width="NaN" MinWidth="40" Height="40" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <svg:Svg Width="20" Height="20" VerticalAlignment="Center" Path="avares://snapvox.editor/Icons/nuclear-sharp.svg" />
                            <TextBlock Text="Clear All" VerticalAlignment="Center" FontSize="{DynamicResource SnapVoxToolbarFontSize}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Name="BottomToolbarBorder" DockPanel.Dock="Bottom" Background="{DynamicResource SnapVoxToolbarBrush}" Height="60" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="0,1,0,0" Cursor="Arrow">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Name="ColorPresetsPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="color-preset" Background="#000000" Click="OnColorSelectClick" Tag="#000000" AutomationProperties.Name="Black" ToolTip.Tip="Black" />
                        <Button Classes="color-preset" Background="#00FF00" Click="OnColorSelectClick" Tag="#00FF00" AutomationProperties.Name="Green" ToolTip.Tip="Green" />
                        <Button Classes="color-preset" Background="#FF0000" Click="OnColorSelectClick" Tag="#FF0000" AutomationProperties.Name="Red" ToolTip.Tip="Red" />
                        <Button Classes="color-preset" Background="#FFFF00" Click="OnColorSelectClick" Tag="#FFFF00" AutomationProperties.Name="Yellow" ToolTip.Tip="Yellow" />
                        <Button Classes="color-preset" Background="#0000FF" Click="OnColorSelectClick" Tag="#0000FF" AutomationProperties.Name="Blue" ToolTip.Tip="Blue" />
                        <Button Classes="color-preset" Background="#FFFFFF" Click="OnColorSelectClick" Tag="#FFFFFF" AutomationProperties.Name="White" ToolTip.Tip="White" />
                    </StackPanel>

                    <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="5,0" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Name="CustomColorBtn" MinWidth="74" MinHeight="40" VerticalAlignment="Center" Cursor="Hand" Padding="6,0" AutomationProperties.Name="Current colour, opens colour picker" ToolTip.Tip="Current color (click to open picker)">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Background="{DynamicResource SnapVoxPanelDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="1" Padding="14" MinWidth="316" MaxWidth="420">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="CUSTOM COLOR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SnapVoxSecondaryTextBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Name="HexPreviewChip" Width="26" Height="26" CornerRadius="4" Background="{DynamicResource SnapVoxAccentBrush}" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="1" ToolTip.Tip="Current picker color" />
                                            </Grid>
                                            <ColorView Name="ColorPickerView" />
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="HEX" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SnapVoxSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Name="HexInput" AutomationProperties.Name="Hex colour code" Watermark="#RRGGBB" MaxLength="9" FontFamily="Consolas, Courier New" FontSize="13" Padding="6,4" Background="{DynamicResource SnapVoxCanvasBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" KeyDown="OnHexInputKeyDown" ToolTip.Tip="Type a hex color; Enter applies it to the tool" />
                                                <Button Grid.Column="2" Name="CopyHexButton" Classes="toolbar" Width="34" Height="34" Margin="6,0,0,0" Click="OnCopyHexClick" AutomationProperties.Name="Copy hex code" ToolTip.Tip="Copy hex code to clipboard">
                                                    <svg:Svg Width="18" Height="18" Path="avares://snapvox.editor/Icons/copy.svg" />
                                                </Button>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                                                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Click="OnSamplerClick" AutomationProperties.Name="Sample a colour from the screen" Background="{DynamicResource SnapVoxSecondaryButtonBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" BorderThickness="0" CornerRadius="4" Cursor="Hand" ToolTip.Tip="Pick any color from the screen (Esc cancels)">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <svg:Svg Width="20" Height="20" Path="avares://snapvox.editor/Icons/custom-color.svg" />
                                                        <TextBlock Text="Sample From Screen" VerticalAlignment="Center" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel colour change" Click="OnColorCancelClick" Margin="6,0,0,0" MinWidth="72" Padding="8,6" HorizontalContentAlignment="Center" Background="{DynamicResource SnapVoxSecondaryButtonBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" BorderThickness="0" CornerRadius="4" Cursor="Hand" />
                                                <Button Grid.Column="2" Content="OK" IsDefault="True" AutomationProperties.Name="Apply colour" Click="OnColorConfirmClick" Margin="6,0,0,0" MinWidth="72" Padding="8,6" HorizontalContentAlignment="Center" Background="{DynamicResource SnapVoxAccentBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" BorderThickness="0" CornerRadius="4" Cursor="Hand" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <svg:Svg Width="18" Height="18" Path="avares://snapvox.editor/Icons/custom-color.svg" />
                                <Border Name="CurrentColorPreview" Width="20" Height="20" CornerRadius="3" Background="{DynamicResource SnapVoxAccentBrush}" BorderBrush="{DynamicResource SnapVoxPrimaryTextBrush}" BorderThickness="1"/>
                            </StackPanel>
                        </Button>
                        <Button Name="CopyCurrentColorBtn" Classes="toolbar" Width="NaN" MinWidth="82" Height="36" Padding="6,0" Click="OnCopyCurrentColorClick" AutomationProperties.Name="Copy current hex color code" ToolTip.Tip="Copy color hex code to clipboard" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Name="CurrentColorHex" Text="#007ACC" VerticalAlignment="Center" FontSize="{DynamicResource SnapVoxToolbarFontSize}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" />
                                <svg:Svg Width="14" Height="14" Path="avares://snapvox.editor/Icons/copy.svg" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    
                    <Button Classes="toolbar" Name="FillToggleBtn" AutomationProperties.Name="Toggle shape fill" ToolTip.Tip="Toggle Shape Fill" Click="OnFillToggleClick" VerticalAlignment="Center" Width="NaN" MinWidth="40" Padding="10,0" Margin="25,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/fill.svg" />
                            <TextBlock Name="FillToggleText" Text="Fill: Off" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="toolbar" Name="ResetCounterBtn" AutomationProperties.Name="Reset counter to 1" ToolTip.Tip="Reset Counter to 1" Click="OnCounterResetClick" VerticalAlignment="Center" Width="NaN" MinWidth="40" Padding="10,0" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/counter.svg" />
                            <TextBlock Text="Reset Counter" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Name="CounterAdjustPanel" Orientation="Vertical" Spacing="2" VerticalAlignment="Center" IsVisible="False" Margin="5,0,0,0">
                        <Button Classes="toolbar" Name="CounterUpBtn" AutomationProperties.Name="Increase counter" ToolTip.Tip="Increment Selected Counter" Click="OnCounterUpClick" Width="26" Height="24" Padding="0" Margin="0">
                            <TextBlock Text="▲" FontSize="11" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="toolbar" Name="CounterDownBtn" AutomationProperties.Name="Decrease counter" ToolTip.Tip="Decrement Selected Counter" Click="OnCounterDownClick" Width="26" Height="24" Padding="0" Margin="0">
                            <TextBlock Text="▼" FontSize="11" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    
                    <StackPanel Name="ThicknessPanel" Orientation="Horizontal" Spacing="2" Margin="25,0,0,0" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="0,0,5,0" />
                        <StackPanel Name="ThicknessChoicesPanel" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                            
                            <TextBlock Name="ThicknessLabel" Text="Thickness" VerticalAlignment="Center" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" FontSize="{DynamicResource SnapVoxToolbarFontSize}" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="1" AutomationProperties.Name="1 pixel thickness" ToolTip.Tip="1px">
                                <Rectangle Width="1" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="2" AutomationProperties.Name="2 pixel thickness" ToolTip.Tip="2px">
                                <Rectangle Width="2" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="3" AutomationProperties.Name="3 pixel thickness" ToolTip.Tip="3px">
                                <Rectangle Width="3" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="5" AutomationProperties.Name="5 pixel thickness" ToolTip.Tip="5px">
                                <Rectangle Width="5" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="8" AutomationProperties.Name="8 pixel thickness" ToolTip.Tip="8px">
                                 <Rectangle Width="8" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="12" AutomationProperties.Name="12 pixel thickness" ToolTip.Tip="12px">
                                 <Rectangle Width="12" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                            <Button Classes="thickness" Click="OnThicknessClick" Tag="16" AutomationProperties.Name="16 pixel thickness" ToolTip.Tip="16px">
                                 <Rectangle Width="16" Height="20" Fill="{DynamicResource SnapVoxToolbarTextBrush}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Name="PixelateToolbarSection" Orientation="Horizontal" Spacing="8" IsVisible="False" VerticalAlignment="Center">
                            <TextBlock Text="Pixelate" VerticalAlignment="Center" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" FontSize="{DynamicResource SnapVoxToolbarFontSize}" FontWeight="SemiBold" Margin="0,0,2,0" />
                            <Slider Name="InlinePixelateSlider"
                                    Classes="pixelate-strength"
                                    Orientation="Horizontal"
                                    Minimum="2"
                                    Maximum="29"
                                    Width="140"
                                    AutomationProperties.Name="Pixelation strength"
                                    ToolTip.Tip="Pixelization strength" />
                            <TextBlock Name="PixelatePercentText" Text="0%" MinWidth="38" VerticalAlignment="Center" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" FontSize="{DynamicResource SnapVoxToolbarFontSize}" FontWeight="SemiBold" TextAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Button Classes="toolbar" Name="SnapToggleBtn" AutomationProperties.Name="Toggle magnetic snapping" ToolTip.Tip="Toggle Magnetic Snapping" Click="OnSnapToggleClick">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/magnet.svg" />
                        </Button>

                        <Rectangle Width="1" Height="30" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="3,0" />

                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SnapVoxToolbarTextBrush}" FontSize="{DynamicResource SnapVoxToolbarFontSize}" FontWeight="SemiBold" />
                        <Button Classes="toolbar" Name="ZoomOutButton" AutomationProperties.Name="Zoom out" Click="OnZoomOutClick" ToolTip.Tip="Zoom Out">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/zoom-out.svg" />
                        </Button>
                        <Button Classes="zoom-text" Name="ZoomText" Content="100%" AutomationProperties.Name="Current zoom level, click to reset to 100 percent" ToolTip.Tip="Reset zoom to 100%" Click="OnZoomResetButtonClick" />
                        <Button Classes="toolbar" Name="ZoomInButton" AutomationProperties.Name="Zoom in" Click="OnZoomInClick" ToolTip.Tip="Zoom In">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/zoom-in.svg" />
                        </Button>
                        <Button Classes="toolbar" Name="ResetZoomButton" AutomationProperties.Name="Reset zoom to 100 percent" ToolTip.Tip="Reset Zoom to 100% (view only, does not change the image)" Click="OnZoomResetButtonClick">
                            <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/zoom-reset.svg" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Background="{DynamicResource SnapVoxToolbarBrush}" Width="60" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="0,0,1,0" Cursor="Arrow">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="LeftToolBar" Orientation="Vertical" Margin="0,10" HorizontalAlignment="Center" Spacing="5">
                    <Button Classes="toolbar" Name="ArrowTool" AutomationProperties.Name="Arrow tool" ToolTip.Tip="Arrow (A). Esc exits this tool." Click="OnToolClick" Tag="Arrow">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/arrow.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="LineTool" AutomationProperties.Name="Line tool" ToolTip.Tip="Line (L). Esc exits this tool." Click="OnToolClick" Tag="Line">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/line.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="RectTool" AutomationProperties.Name="Rectangle tool" ToolTip.Tip="Rectangle. Esc exits this tool." Click="OnToolClick" Tag="Rectangle">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/square.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="EllipseTool" AutomationProperties.Name="Ellipse tool" ToolTip.Tip="Circle/Ellipse. Esc exits this tool." Click="OnToolClick" Tag="Ellipse">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/circle.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="FreeDrawTool" AutomationProperties.Name="Free draw tool" ToolTip.Tip="Free Draw (D). Esc exits this tool." Click="OnToolClick" Tag="FreeDraw">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/pencil.svg" />
                    </Button>
                    
                    <Rectangle Width="30" Height="1" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="0,3" />
                    
                    <Button Classes="toolbar" Name="HighlightTool" AutomationProperties.Name="Highlight tool" ToolTip.Tip="Highlight (H). Esc exits this tool." Click="OnToolClick" Tag="Highlight">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/highlight.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="BlurTool" AutomationProperties.Name="Pixelate tool" ToolTip.Tip="Pixelate (O/P). Esc exits this tool." Click="OnToolClick" Tag="Blur">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/pixelite.svg" />
                    </Button>

                    <Rectangle Width="30" Height="1" Fill="{DynamicResource SnapVoxSeparatorBrush}" Margin="0,3" />
                    
                    <Button Classes="toolbar" Name="TextTool" AutomationProperties.Name="Text tool" ToolTip.Tip="Text (T). Esc exits this tool." Click="OnToolClick" Tag="Text">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/text.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="CounterTool" AutomationProperties.Name="Counter tool" Click="OnToolClick" DoubleTapped="OnCounterDoubleTapped" Tag="Counter" ToolTip.Tip="Counter (I). Double-click to reset to 1. Esc exits this tool.">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/counter.svg" />
                    </Button>
                    <Button Classes="toolbar" Name="EmojiTool" AutomationProperties.Name="Emoji tool" ToolTip.Tip="Emoji (E). Esc exits this tool." Click="OnToolClick" Tag="Emoji">
                        <svg:Svg Width="24" Height="24" Path="avares://snapvox.editor/Icons/emoji.svg" />
                        <Button.Flyout>
                            <Flyout Placement="Right">
                                <ScrollViewer MaxHeight="300" AllowAutoHide="False" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Styles>
                                        <Style Selector="ScrollBar">
                                            <Setter Property="AllowAutoHide" Value="False" />
                                        </Style>
                                        <Style Selector="ScrollBar:vertical">
                                            <Setter Property="Theme" Value="{StaticResource SnapVoxScrollBarVertical}" />
                                        </Style>
                                    </ScrollViewer.Styles>
                                    <ItemsControl Name="EmojiGrid">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="54" ItemHeight="54" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="emoji-btn"
                                                        Content="{Binding}"
                                                        Tag="{Binding}"
                                                        AutomationProperties.Name="{Binding}"
                                                        ToolTip.Tip="{Binding}"
                                                        Click="OnEmojiSelectClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Panel Background="{StaticResource CheckerboardBrush}">
                <Grid Name="MainGrid">
                    
                    <Panel Name="ZoomContainer" HorizontalAlignment="Left" VerticalAlignment="Top">
                        
                        <Border Name="SnipBorder" BorderBrush="{DynamicResource SnapVoxFrameBorderBrush}" BorderThickness="3">
                            <Image Name="EditorImage" AutomationProperties.Name="Captured image" Margin="0" Stretch="None" />
                        </Border>
                        <Canvas Name="AnnotationCanvas" Background="Transparent" 
                                PointerPressed="OnCanvasPointerPressed" 
                                PointerMoved="OnCanvasPointerMoved" 
                                PointerReleased="OnCanvasPointerReleased"
                                ClipToBounds="True">
                                
                        </Canvas>

                        <Canvas Name="OverlayCanvas" ClipToBounds="False" ZIndex="10000">
                            <Border Name="ContextToolbar" IsVisible="False" ZIndex="10001" Background="{DynamicResource SnapVoxPanelDarkBrush}" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="action context-apply" Name="ContextApplyButton" Click="OnContextApplyClick" AutomationProperties.Name="Apply" ToolTip.Tip="Apply (Enter)">
                                        <svg:Svg Width="20" Height="20" Path="avares://snapvox.editor/Icons/check.svg" />
                                    </Button>
                                    <Rectangle Name="ContextApplySeparator" Width="1" Height="28" Fill="{DynamicResource SnapVoxSeparatorBrush}" VerticalAlignment="Center" />
                                    <Button Classes="action context-duplicate" Name="ContextDuplicateButton" Click="OnDuplicateClick" AutomationProperties.Name="Duplicate object" ToolTip.Tip="Duplicate (Ctrl+D)">
                                        <svg:Svg Width="20" Height="20" Path="avares://snapvox.editor/Icons/duplicate.svg" />
                                    </Button>
                                    <Rectangle Width="1" Height="28" Fill="{DynamicResource SnapVoxSeparatorBrush}" VerticalAlignment="Center" />
                                    <Button Classes="action context-delete" Name="ContextDeleteButton" Click="OnDeleteClick" AutomationProperties.Name="Delete object" ToolTip.Tip="Delete (Del) / Cancel (Esc)">
                                        <svg:Svg Width="20" Height="20" Path="avares://snapvox.editor/Icons/delete.svg" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Name="OcrContextToolbar" IsVisible="False" ZIndex="10002" Background="{DynamicResource SnapVoxPanelDarkBrush}" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="1.5" CornerRadius="6" Padding="4" BoxShadow="0 4 12 0 #99000000">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="action context-duplicate" Name="OcrContextCopyButton" Click="OnOcrContextCopyClick" AutomationProperties.Name="Copy recognised text" ToolTip.Tip="Copy Text (Ctrl+C)" Width="NaN" MinWidth="100" Height="36" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <svg:Svg Width="18" Height="18" Path="avares://snapvox.editor/Icons/copy.svg" />
                                            <TextBlock Text="Copy Text" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="action context-duplicate" Name="OcrContextOpenLinkButton" Click="OnOcrContextOpenLinkClick" AutomationProperties.Name="Open link" ToolTip.Tip="Open URL" Width="NaN" MinWidth="100" Height="36" Padding="10,0" IsVisible="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <svg:Svg Width="18" Height="18" Path="avares://snapvox.editor/Icons/link.svg" />
                                            <TextBlock Text="Open Link" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="action context-duplicate" Name="OcrContextEmailButton" Click="OnOcrContextEmailClick" AutomationProperties.Name="Compose email" ToolTip.Tip="Compose Email" Width="NaN" MinWidth="100" Height="36" Padding="10,0" IsVisible="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <svg:Svg Width="18" Height="18" Path="avares://snapvox.editor/Icons/email.svg" />
                                            <TextBlock Text="Email" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Canvas Name="StartPointHandle" Width="24" Height="24" IsVisible="False" ZIndex="10002" Cursor="Hand" AutomationProperties.Name="Line start handle">
                                <Ellipse Width="24" Height="24" Fill="{DynamicResource SnapVoxPrimaryTextBrush}" />
                                <Ellipse Width="21" Height="21" Margin="1.5" Stroke="{DynamicResource SnapVoxSuccessBrush}" StrokeThickness="2.5" />
                                <Ellipse Width="10" Height="10" Margin="7" Fill="{DynamicResource SnapVoxSuccessBrush}" />
                            </Canvas>
                            <Canvas Name="EndPointHandle" Width="24" Height="24" IsVisible="False" ZIndex="10002" Cursor="Hand" AutomationProperties.Name="Line end handle">
                                <Ellipse Width="24" Height="24" Fill="{DynamicResource SnapVoxPrimaryTextBrush}" />
                                <Ellipse Width="21" Height="21" Margin="1.5" Stroke="{DynamicResource SnapVoxAccentBrush}" StrokeThickness="2.5" />
                                <Ellipse Width="10" Height="10" Margin="7" Fill="{DynamicResource SnapVoxAccentBrush}" />
                            </Canvas>
                        </Canvas>
                    </Panel>
                </Grid>
            </Panel>
        </ScrollViewer>
    </DockPanel>

    <Grid Name="ClosePromptOverlay" IsVisible="False" ZIndex="100000" Background="{DynamicResource SnapVoxScrimBrush}"
          Focusable="True" KeyDown="OnClosePromptKeyDown"
          KeyboardNavigation.TabNavigation="Cycle"
          AutomationProperties.Name="Unsaved changes confirmation">
        <Border Background="{DynamicResource SnapVoxPanelDarkBrush}" CornerRadius="8" BorderBrush="{DynamicResource SnapVoxSeparatorBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" MaxWidth="460">
            <StackPanel Spacing="20">
                <TextBlock Text="Unsaved Changes" FontWeight="Bold" FontSize="{DynamicResource SnapVoxDialogTitleFontSize}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" />
                <TextBlock Name="ClosePromptMessage" Text="You have unsaved changes. Discard permanently deletes everything you added to this image." TextWrapping="Wrap" Foreground="{DynamicResource SnapVoxSecondaryTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Name="ClosePromptSaveButton" Content="Save and Close" Click="OnPromptSaveClose" AutomationProperties.Name="Save and close" Background="{DynamicResource SnapVoxAccentBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" MinWidth="110" MinHeight="32" HorizontalContentAlignment="Center" Padding="12,6" Cursor="Hand" />
                    <Button Name="ClosePromptDiscardButton" Content="Discard" Click="OnPromptDiscard" AutomationProperties.Name="Discard changes and close" Background="{DynamicResource SnapVoxDestructiveBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" MinWidth="90" MinHeight="32" HorizontalContentAlignment="Center" Padding="12,6" Cursor="Hand" />
                    <Button Name="ClosePromptCancelButton" Content="Cancel" Click="OnPromptCancel" AutomationProperties.Name="Keep editing" Background="{DynamicResource SnapVoxSecondaryButtonBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" MinWidth="90" MinHeight="32" HorizontalContentAlignment="Center" Padding="12,6" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Panel>
</Window>