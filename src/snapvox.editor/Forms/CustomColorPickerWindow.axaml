<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="snapvox.editor.forms.CustomColorPickerWindow"
        Title="Custom Color"
        Width="350" Height="480"
        MinWidth="320" MinHeight="440"
        Background="{DynamicResource SnapVoxPanelDarkBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <!-- ISSUE_012: theme is set once at the Application level (App.axaml). -->
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Select Custom Color" FontSize="{DynamicResource SnapVoxDialogTitleFontSize}" FontWeight="Bold" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}" HorizontalAlignment="Center"/>
        
        <!-- ISSUE_016: ColorPicker is two-way bound to SelectedColor so the screen and data stay in sync. -->
        <ColorPicker Name="Picker" HorizontalAlignment="Center" Color="{Binding SelectedColor, Mode=TwoWay}" />
        
        <Button Name="SamplerBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Click="OnSamplerClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="󰈋" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                <TextBlock Text="Sample Color From Screen" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="OK" Click="OnOkClick" Margin="0,0,5,0" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource SnapVoxAccentBrush}" Foreground="{DynamicResource SnapVoxPrimaryTextBrush}"/>
            <Button Grid.Column="1" Content="Cancel" Click="OnCancelClick" Margin="5,0,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>